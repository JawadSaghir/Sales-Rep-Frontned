NEXT_PUBLIC_API_BASE=https://sales-rep-api-j4aw.onrender.com

# --- Auth (Google sign-in, company domains only) ---------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (shared with the sales-performance-dashboard client;
# the Vercel + localhost callback URLs must be added as authorized redirect
# URIs on that client in Google Cloud Console).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local dev only. On Vercel, set AUTH_URL to the deployed URL
# (e.g. https://<project>.vercel.app).
AUTH_URL=http://localhost:3000
# Optional: override the built-in company domain allowlist (comma-separated).
# Defaults: insidesuccesstv.com,insidesuccess.com,mawercapital.com,nextlevelceotv.com
# AUTH_ALLOWED_DOMAINS=
