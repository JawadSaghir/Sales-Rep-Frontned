NEXT_PUBLIC_API_BASE=https://sales-rep-api-j4aw.onrender.com

# --- Auth (Google sign-in, company domains only) ---------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (shared with the sales-performance-dashboard client;
# the Vercel + localhost callback URLs must be added as authorized redirect
# URIs on that client in Google Cloud Console).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Local dev only. On Vercel, set AUTH_URL to the deployed URL
# (e.g. https://<project>.vercel.app).
AUTH_URL=http://localhost:3000
# Optional: override the built-in company domain allowlist (comma-separated).
# Defaults: insidesuccesstv.com,insidesuccess.com,mawercapital.com,nextlevelceotv.com
# AUTH_ALLOWED_DOMAINS=

# --- BFF proxy (app/api/backend/[...path]/route.ts) ------------------------
# The browser never talks to FastAPI directly: it calls /api/backend/*, which
# verifies the NextAuth session, mints a 60s identity-only JWT, and forwards.
#
# USER_PROXY_SECRET signs that JWT and the API verifies it with the SAME string
# (HS256 is symmetric) — it must be the SAME VALUE as the API's USER_PROXY_SECRET,
# byte for byte, or every request comes back 401. Missing here, the proxy throws
# "USER_PROXY_SECRET is not configured" before it even reaches the API.
# Generate with 32+ random bytes, e.g.:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
USER_PROXY_SECRET=
# Where the proxy forwards to, scheme included. Server-side only — unlike
# NEXT_PUBLIC_API_BASE this is never inlined into the browser bundle, so it can
# change with a restart instead of a rebuild.
BACKEND_URL=http://localhost:8000
